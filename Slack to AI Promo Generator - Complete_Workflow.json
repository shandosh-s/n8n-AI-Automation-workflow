        "jsCode": "// Extract Video from completed operation\nconst response = $input.first().json;\n\n// When done=true, video is in response.response.videos\nif (!response.done) {\n    throw new Error('Operation not complete yet');\n}\n\nconst videoData = response.response;\nif (!videoData || !videoData.videos || !videoData.videos[0]) {\n    throw new Error('No video in response: ' + JSON.stringify(response).substring(0, 500));\n}\n\nconst video = videoData.videos[0];\n\nreturn [{\n    json: {\n        videoBase64: video.bytesBase64Encoded,\n        videoMimeType: video.mimeType || 'video/mp4',\n        operationName: response.name\n    }\n}];"
