      "parameters": {
        "jsCode": "// Extract Intent & Parameters\nconst text = $input.first().json.text;\nconst channel = $input.first().json.channel;\nconst user = $input.first().json.user;\n\n// Remove bot mention from text (e.g., <@U12345>)\nconst cleanText = text.replace(/<@[A-Z0-9]+>/g, '').trim();\n\nreturn [{\n  json: {\n    promotionalText: cleanText,\n    channel: channel,\n    requestedBy: user,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "b52d1c52-6612-4992-af50-683c8953af0e",
      "name": "Extract Intent & Parameters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -272
      ]
    },
    {
      "parameters": {
        "jsCode": "// ✅ Parse GPT Response Safely\n\nlet response;\n\n// Safely extract response text\ntry {\n  response = $input.first().json.choices?.[0]?.message?.content || $input.first().json.text || '';\n} catch (error) {\n  response = '';\n}\n\n// Ensure it's a string\nif (typeof response !== 'string') {\n  response = JSON.stringify(response);\n}\n\nlet jsonStr = response;\n\n// ✅ Handle markdown code blocks like ```json ... ```\nif (response && response.includes('```json')) {\n  jsonStr = response.split('```json')[1]?.split('```')[0]?.trim();\n} else if (response && response.includes('```')) {\n  jsonStr = response.split('```')[1]?.trim();\n}\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(jsonStr);\n} catch (error) {\n  // if it’s not valid JSON, just keep it as plain text\n  parsed = { text: jsonStr };\n}\n\n// ✅ Pass along useful context from earlier nodes\nreturn [\n  {\n    json: {\n      ...parsed,\n      channel: $('Extract Intent & Parameters').first().json.channel,\n      requestedBy: $('Extract Intent & Parameters').first().json.requestedBy,\n      originalText: $('Extract Intent & Parameters').first().json.promotionalText\n    }\n  }\n];\n"
      },
      "id": "cf1da45b-c057-40b2-b399-9714962b039c",
      "name": "Parse GPT Response",
